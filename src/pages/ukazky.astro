---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import data from '../content/portfolio.json';

const title = 'Ukázky z portfolia | Hezké webovky';
const description = 'Prohlédněte si weby, které jsem vytvořil. Firemní weby, landing pages a prezentace pro živnostníky a malé firmy v celé České republice.';

const projects = data.projects;
const featured = projects[0];
const rest = projects.slice(1);
---

<Layout {title} {description} noLoader>
  <Nav />
  <main>

    <!-- Hero -->
    <section class="pt-28 pb-16 md:pt-40 md:pb-20 relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
           style="background: radial-gradient(ellipse 55% 50% at 65% 40%, rgba(200,255,0,0.07) 0%, transparent 60%)">
      </div>
      <div class="relative z-10 max-w-[1400px] mx-auto px-4 md:px-8">
        <nav class="text-xs text-text-muted mb-8 flex items-center gap-2" aria-label="Breadcrumb">
          <a href="/" class="hover:text-accent transition-colors">Hezké webovky</a>
          <span>/</span>
          <span class="text-white/50">Ukázky</span>
        </nav>
        <div class="max-w-3xl">
          <div class="text-text-muted text-xs tracking-[0.3em] uppercase mb-5">Portfolio</div>
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.0] mb-6">
            Weby, které<br/>
            <span class="text-accent">jsem vytvořil</span>
          </h1>
          <p class="text-text-secondary text-xl leading-relaxed max-w-2xl">
            {data.subtext}
          </p>
        </div>
      </div>
    </section>

    <!-- Featured project -->
    <section class="pb-6">
      <div class="max-w-[1400px] mx-auto px-4 md:px-8">
        <a
          href={featured.url}
          target={featured.url !== '#' ? '_blank' : undefined}
          rel={featured.url !== '#' ? 'noopener noreferrer' : undefined}
          class="group block"
          data-hover
        >
          <div class="flex items-center justify-between mb-3">
            <span class="text-[10px] text-text-muted tracking-wider uppercase">{featured.category}</span>
            <span class="text-text-muted text-xs font-mono">{featured.year}</span>
          </div>
          <div class="relative aspect-[16/7] bg-dark-card rounded-2xl overflow-hidden">
            <img
              src={featured.image}
              alt={`Webové stránky ${featured.title} – ukázka portfolia`}
              loading="eager"
              class="absolute inset-0 w-full h-full object-cover object-top transition-all duration-[1.2s] ease-out group-hover:scale-[1.03]"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-700 flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-3 group-hover:translate-y-0">
                <div class="flex items-center gap-2.5 px-6 py-3 bg-accent text-black rounded-full text-sm font-bold">
                  Zobrazit web
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-4 flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-semibold group-hover:text-accent transition-colors duration-500">{featured.title}</h2>
              <p class="text-text-secondary text-sm mt-1.5 leading-relaxed">{featured.description}</p>
            </div>
            <div class="shrink-0 mt-1 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
              </svg>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- Grid of remaining projects -->
    <section class="pt-6 pb-24 md:pb-32">
      <div class="max-w-[1400px] mx-auto px-4 md:px-8">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {rest.map((project) => (
            <a
              href={project.url}
              target={project.url !== '#' ? '_blank' : undefined}
              rel={project.url !== '#' ? 'noopener noreferrer' : undefined}
              class="group block"
              data-hover
            >
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] text-text-muted tracking-wider uppercase">{project.category}</span>
                <span class="text-text-muted text-xs font-mono">{project.year}</span>
              </div>
              <div class="relative aspect-[16/10] bg-dark-card rounded-xl overflow-hidden">
                <img
                  src={project.image}
                  alt={`Webové stránky ${project.title} – ukázka portfolia`}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover object-top transition-all duration-[1.2s] ease-out group-hover:scale-[1.05]"
                />
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-700 flex items-center justify-center">
                  <div class="opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-3 group-hover:translate-y-0">
                    <div class="w-14 h-14 rounded-full border border-accent flex items-center justify-center bg-accent/10">
                      <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-4">
                <h2 class="text-lg font-semibold group-hover:text-accent transition-colors duration-500">{project.title}</h2>
                <p class="text-text-secondary text-sm mt-1.5 leading-relaxed">{project.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 md:py-32 section-gradient">
      <div class="max-w-[1400px] mx-auto px-4 md:px-8 text-center">
        <div class="text-text-muted text-xs tracking-[0.3em] uppercase mb-5">Další projekt</div>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">
          Váš web může být<br/><span class="text-accent">další ukázkou.</span>
        </h2>
        <p class="text-text-secondary text-lg max-w-xl mx-auto mb-10">
          Napište mi a domluvíme se na bezplatné konzultaci. Bez závazků, bez agenturnich nesmyslů.
        </p>
        <a href="/#kontakt" class="inline-flex items-center gap-3 px-8 py-5 bg-accent text-black rounded-full font-bold text-sm tracking-wider uppercase hover:bg-white transition-all duration-500">
          Chci hezký web
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/>
          </svg>
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Hezké webovky", "item": "https://hezkewebovky.cz" },
    { "@type": "ListItem", "position": 2, "name": "Ukázky", "item": "https://hezkewebovky.cz/ukazky" }
  ]
})} /></script>
