---
---

<section class="py-24 md:py-32 relative overflow-hidden">

  <!-- Full background image with overlay -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <img
      src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=1600&q=80&auto=format&fit=crop"
      alt=""
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
    <!-- Dark overlay -->
    <div class="absolute inset-0" style="background: linear-gradient(130deg, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.80) 50%, rgba(10,10,10,0.88) 100%)"></div>
    <!-- Accent glow -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 55% 65% at 75% 50%, rgba(200,255,0,0.07) 0%, transparent 55%)"></div>
  </div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-4 md:px-8">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">

      <!-- Left: text content -->
      <div class="reveal">
        <div class="text-text-muted text-xs tracking-[0.3em] uppercase mb-5">Náš přístup</div>
        <h2 class="text-4xl md:text-5xl lg:text-[3.25rem] font-bold tracking-tight leading-[1.08] mb-6">
          Weby, které<br/>
          <span class="text-accent">dělají dojem.</span>
        </h2>
        <p class="text-text-secondary text-lg leading-relaxed max-w-md mb-8">
          Každý projekt začíná důkladným pochopením vaší firmy. Výsledek není jen hezký — je rychlý, funkční a pomáhá vám prodávat.
        </p>

        <div class="space-y-3.5 mb-10">
          {[
            'Moderní design na míru',
            'Rychlé načítání (Core Web Vitals)',
            'SEO optimalizace od prvního dne',
            'Správa obsahu přes Sanity CMS',
          ].map((item) => (
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 border" style="background:rgba(200,255,0,0.1); border-color:rgba(200,255,0,0.25);">
                <svg class="w-2.5 h-2.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-text-secondary text-sm">{item}</span>
            </div>
          ))}
        </div>

        <a href="#ukazky" class="magnetic-btn group inline-flex items-center gap-3 text-white" data-hover>
          <span class="text-sm tracking-wider uppercase">Prohlédnout ukázky</span>
          <span class="w-10 h-10 rounded-full border flex items-center justify-center group-hover:bg-accent group-hover:border-accent transition-all duration-500" style="border-color:rgba(200,255,0,0.4);">
            <svg class="w-3.5 h-3.5 text-accent group-hover:text-black transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </span>
        </a>
      </div>

      <!-- Right: video card -->
      <div class="reveal reveal-delay-1 flex justify-start md:justify-end">
        <div
          class="relative w-full max-w-[460px] rounded-2xl overflow-hidden border border-dark-border/60 shadow-2xl shadow-black/70 group cursor-pointer"
          style="aspect-ratio: 16/10;"
          id="video-card"
          data-hover
        >
          <!-- Poster image -->
          <img
            src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800&q=80&auto=format&fit=crop"
            alt="Video ukázka procesu tvorby webu"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            id="video-poster"
          />

          <!-- Overlay -->
          <div class="absolute inset-0 bg-dark/35 group-hover:bg-dark/25 transition-colors duration-500"></div>

          <!-- Play button -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div
              class="w-16 h-16 rounded-full border-2 flex items-center justify-center transition-all duration-500 group-hover:scale-110"
              style="border-color:rgba(255,255,255,0.6); background:rgba(255,255,255,0.1); backdrop-filter:blur(4px); group-hover-border-color: #c8ff00;"
              id="play-btn"
            >
              <svg class="w-6 h-6 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>

          <!-- Label badge -->
          <div class="absolute bottom-4 left-4 flex items-center gap-2 px-3 py-1.5 rounded-full border border-dark-border/60 bg-dark-card/80" style="backdrop-filter: blur(8px);">
            <div class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></div>
            <span class="text-xs text-white/80">Jak tvořím weby</span>
          </div>

          <!-- Hidden video — doplňte src pro přehrávání -->
          <video
            id="video-player"
            class="absolute inset-0 w-full h-full object-cover hidden"
            preload="none"
            playsinline
            controls
          >
            {/* <source src="URL_K_VASEMU_VIDEU.mp4" type="video/mp4" /> */}
          </video>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const card = document.getElementById('video-card');
  const player = document.getElementById('video-player') as HTMLVideoElement | null;
  const poster = document.getElementById('video-poster');
  const playBtn = document.getElementById('play-btn');

  card?.addEventListener('click', () => {
    if (!player) return;
    const hasSrc = player.querySelector('source') || player.src;
    if (hasSrc) {
      poster?.classList.add('hidden');
      playBtn?.parentElement?.classList.add('hidden');
      card.querySelector('.absolute.inset-0.bg-dark\\/35')?.classList.add('hidden');
      card.querySelector('.absolute.bottom-4')?.classList.add('hidden');
      player.classList.remove('hidden');
      player.play();
    }
  });
</script>
