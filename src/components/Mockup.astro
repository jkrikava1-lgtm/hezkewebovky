---
---

<section class="relative overflow-hidden py-10 md:py-16" id="ukazka">
  <div class="relative max-w-5xl mx-auto px-4">

    <div class="flex flex-col md:flex-row items-center justify-center gap-10 md:gap-16">

      <!-- Label -->
      <div class="reveal text-center md:text-left order-2 md:order-1">
        <div class="text-xs text-text-muted tracking-[0.25em] uppercase leading-relaxed">
          <span class="inline-flex items-center gap-3">
            <span class="w-6 h-px bg-accent/40 hidden md:block"></span>
            Náš web funguje skvěle<br />i na mobilních zařízeních
          </span>
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="mockup-phone w-[150px] md:w-[200px] reveal order-1 md:order-2">
        <div class="phone-body">
          <div class="phone-island"></div>
          <div class="phone-screen">
            <img src="/screenshot-mobile.webp" alt="Web hezkewebovky.cz na mobilu" loading="lazy" />
          </div>
          <div class="phone-btn phone-btn-r"></div>
          <div class="phone-btn phone-btn-l1"></div>
          <div class="phone-btn phone-btn-l2"></div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .mockup-phone {
    filter:
      drop-shadow(0 24px 48px rgba(0,0,0,0.65))
      drop-shadow(0 4px 10px rgba(0,0,0,0.4));
  }

  .phone-body {
    position: relative;
    background: #111;
    border-radius: 40px;
    padding: 11px;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.12),
      0 0 0 1px rgba(0,0,0,0.5);
  }

  .phone-island {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 70px;
    height: 20px;
    background: #000;
    border-radius: 20px;
    z-index: 10;
  }

  .phone-screen {
    border-radius: 30px;
    overflow: hidden;
    background: #000;
    mask-image: linear-gradient(to bottom, black 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 88%, transparent 100%);
  }
  .phone-screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .phone-btn {
    position: absolute;
    background: #1a1a1a;
    border-radius: 2px;
  }
  .phone-btn-r  { right: -3px; top: 90px;  width: 3px; height: 44px; border-radius: 0 2px 2px 0; }
  .phone-btn-l1 { left: -3px;  top: 70px;  width: 3px; height: 24px; border-radius: 2px 0 0 2px; }
  .phone-btn-l2 { left: -3px;  top: 103px; width: 3px; height: 44px; border-radius: 2px 0 0 2px; }
</style>
