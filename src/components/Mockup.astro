---
---

<section class="relative overflow-hidden py-10 md:py-16" id="ukazka">

  <!-- Label -->
  <div class="text-center mb-8 md:mb-12 reveal relative z-10">
    <div class="inline-flex items-center gap-3 text-xs text-text-muted tracking-[0.25em] uppercase">
      <div class="w-6 h-px bg-accent/40"></div>
      Funguje skvěle na všech zařízeních
      <div class="w-6 h-px bg-accent/40"></div>
    </div>
  </div>

  <!-- Devices -->
  <div class="relative max-w-5xl mx-auto h-[340px] md:h-[500px] px-4">

    <!-- Laptop -->
    <img
      src="/device-laptop.webp"
      alt="Web hezkewebovky.cz na notebooku"
      class="absolute bottom-0 left-[-4%] md:left-[0%] w-[72%] md:w-[68%] h-auto reveal"
      loading="lazy"
      style="
        mask-image: radial-gradient(ellipse 90% 88% at 48% 68%, black 42%, transparent 90%);
        -webkit-mask-image: radial-gradient(ellipse 90% 88% at 48% 68%, black 42%, transparent 90%);
      "
    />

    <!-- Phone -->
    <img
      src="/device-phone.webp"
      alt="Web hezkewebovky.cz na mobilu"
      class="absolute bottom-0 right-[-2%] md:right-[4%] w-[26%] md:w-[22%] h-auto reveal"
      loading="lazy"
      style="
        mask-image: radial-gradient(ellipse 72% 88% at 50% 60%, black 40%, transparent 90%);
        -webkit-mask-image: radial-gradient(ellipse 72% 88% at 50% 60%, black 40%, transparent 90%);
      "
    />

  </div>

</section>
