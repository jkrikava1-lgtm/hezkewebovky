---
---

<section class="relative overflow-hidden py-10 md:py-16" id="ukazka">

  <div class="relative max-w-5xl mx-auto px-4">

    <!-- Label -->
    <div class="text-center mb-6 md:mb-10 reveal">
      <div class="inline-flex items-center gap-3 text-xs text-text-muted tracking-[0.25em] uppercase">
        <div class="w-6 h-px bg-accent/40"></div>
        Funguje skvěle na všech zařízeních
        <div class="w-6 h-px bg-accent/40"></div>
      </div>
    </div>

    <div class="relative h-[320px] md:h-[560px]">

      <!-- Desktop / Laptop mockup -->
      <div class="mockup-laptop absolute bottom-0 left-0 w-[76%] md:w-[70%] reveal">

        <!-- Screen lid -->
        <div class="laptop-lid">
          <div class="browser-chrome">
            <div class="browser-dots">
              <span class="dot dot-r"></span>
              <span class="dot dot-y"></span>
              <span class="dot dot-g"></span>
            </div>
            <div class="browser-url">hezkewebovky.cz</div>
          </div>
          <div class="browser-screen">
            <div class="ms-site">

              <!-- Mini nav -->
              <div class="ms-nav">
                <div class="ms-logo">hezké<span>webovky</span></div>
                <div class="ms-nav-links">SLUŽBY · UKÁZKY · CENA · KONTAKT</div>
                <div class="ms-cta-btn">CHCI HEZKÝ WEB</div>
              </div>

              <!-- Mini hero -->
              <div class="ms-hero">
                <div class="ms-eyebrow">WEBOVÉ STRÁNKY PRO FIRMY VŠECH VELIKOSTÍ</div>
                <div class="ms-heading">
                  <span class="ms-glitch" data-text="Váš web je vaše">Váš web je vaše</span><br>
                  <span class="ms-glitch ms-accent" data-text="vizitka">vizitka</span>
                </div>
                <p class="ms-para"><span class="ms-typed"></span><span class="ms-cursor">|</span></p>
              </div>

            </div>
          </div>
        </div>

        <!-- Bottom bezel (tenký rámeček jako u MacBook screenu) -->
        <div class="laptop-bezel"></div>

      </div>

      <!-- Phone mockup -->
      <div class="mockup-phone absolute bottom-0 right-0 md:right-[2%] w-[26%] md:w-[22%] reveal">
        <div class="phone-body">
          <div class="phone-island"></div>
          <div class="phone-screen">
            <img src="/screenshot-mobile.webp" alt="Web hezkewebovky.cz na mobilu" loading="lazy" />
          </div>
          <div class="phone-btn phone-btn-r"></div>
          <div class="phone-btn phone-btn-l1"></div>
          <div class="phone-btn phone-btn-l2"></div>
        </div>
      </div>

    </div>

  </div>


</section>

<style>
  /* ── Laptop mockup ──────────────────────────────── */
  .laptop-lid {
    border-radius: 8px 8px 0 0;
    overflow: hidden;
    background: #111;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.08),
      0 20px 60px rgba(0,0,0,0.65),
      0 4px 12px rgba(0,0,0,0.4);
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: #1a1f1a;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .browser-dots { display: flex; gap: 6px; flex-shrink: 0; }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }

  .browser-url {
    flex: 1;
    background: rgba(255,255,255,0.06);
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 11px;
    color: rgba(255,255,255,0.3);
    font-family: ui-monospace, monospace;
    text-align: center;
  }

  .browser-screen {
    display: block;
    background: #070d07;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  /* ── Mini website inside browser ───────────────── */
  .ms-site {
    background: #070d07;
    font-family: system-ui, -apple-system, sans-serif;
    user-select: none;
  }

  .ms-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(8px, 1.2vw, 14px) clamp(12px, 2vw, 24px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .ms-logo {
    font-size: clamp(10px, 1.1vw, 15px);
    font-weight: 800;
    color: white;
    letter-spacing: -0.02em;
  }
  .ms-logo span { color: #c8ff00; }
  .ms-nav-links {
    font-size: clamp(6px, 0.6vw, 9px);
    letter-spacing: 0.15em;
    color: rgba(255,255,255,0.35);
  }
  .ms-cta-btn {
    font-size: clamp(6px, 0.65vw, 9px);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #000;
    background: #c8ff00;
    padding: clamp(3px, 0.4vw, 5px) clamp(7px, 0.8vw, 12px);
    border-radius: 20px;
  }

  .ms-hero {
    padding: clamp(16px, 2.5vw, 36px) clamp(12px, 2vw, 24px) clamp(12px, 2vw, 24px);
  }
  .ms-eyebrow {
    font-size: clamp(5px, 0.55vw, 8px);
    letter-spacing: 0.25em;
    color: rgba(255,255,255,0.3);
    margin-bottom: clamp(10px, 1.4vw, 18px);
  }

  .ms-heading {
    font-size: clamp(18px, 3vw, 44px);
    font-weight: 800;
    line-height: 1.0;
    color: white;
    letter-spacing: -0.03em;
    margin-bottom: clamp(10px, 1.5vw, 22px);
  }
  .ms-accent { color: #c8ff00; }

  /* Always-on glitch */
  .ms-glitch {
    position: relative;
    display: inline-block;
  }
  .ms-glitch::before,
  .ms-glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
  }
  .ms-glitch::before {
    color: #ff00c8;
    animation: ms-g1 4s infinite;
  }
  .ms-glitch::after {
    color: #00fff9;
    animation: ms-g2 4s infinite;
  }
  @keyframes ms-g1 {
    0%,80%,100% { transform: translate(0); opacity: 0; }
    81%,84% { transform: translate(-3px, 1px); opacity: 0.75; clip-path: inset(10% 0 70% 0); }
    85%,88% { transform: translate(2px,-1px); opacity: 0.75; clip-path: inset(50% 0 20% 0); }
    89%,92% { transform: translate(-2px, 2px); opacity: 0.75; clip-path: inset(30% 0 50% 0); }
  }
  @keyframes ms-g2 {
    0%,80%,100% { transform: translate(0); opacity: 0; }
    82%,85% { transform: translate(3px,-1px); opacity: 0.75; clip-path: inset(60% 0 10% 0); }
    86%,89% { transform: translate(-2px, 1px); opacity: 0.75; clip-path: inset(20% 0 60% 0); }
    90%,93% { transform: translate(2px,-2px); opacity: 0.75; clip-path: inset(40% 0 30% 0); }
  }

  .ms-para {
    font-size: clamp(8px, 0.85vw, 13px);
    line-height: 1.6;
    color: rgba(255,255,255,0.55);
    min-height: 2.8em;
  }
  .ms-cursor {
    display: inline-block;
    color: #c8ff00;
    animation: blink 0.8s step-end infinite;
    margin-left: 1px;
    font-weight: 300;
  }

  /* Tenký spodní bezel – naznačuje laptop rámeček */
  .laptop-bezel {
    height: 10px;
    background: linear-gradient(to bottom, #bbb, #999);
    border-radius: 0 0 5px 5px;
  }

  /* ── Phone mockup ───────────────────────────────── */
  .mockup-phone {
    filter:
      drop-shadow(0 24px 48px rgba(0,0,0,0.65))
      drop-shadow(0 4px 10px rgba(0,0,0,0.4));
  }

  .phone-body {
    position: relative;
    background: #111;
    border-radius: 40px;
    padding: 11px;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.12),
      0 0 0 1px rgba(0,0,0,0.5);
  }

  .phone-island {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 22px;
    background: #000;
    border-radius: 20px;
    z-index: 10;
  }

  .phone-screen {
    border-radius: 30px;
    overflow: hidden;
    background: #000;
    mask-image: linear-gradient(to bottom, black 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 88%, transparent 100%);
  }
  .phone-screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .phone-btn {
    position: absolute;
    background: #1a1a1a;
    border-radius: 2px;
  }
  .phone-btn-r  { right: -3px; top: 110px; width: 3px; height: 52px; border-radius: 0 2px 2px 0; }
  .phone-btn-l1 { left: -3px;  top: 85px;  width: 3px; height: 28px; border-radius: 2px 0 0 2px; }
  .phone-btn-l2 { left: -3px;  top: 125px; width: 3px; height: 52px; border-radius: 2px 0 0 2px; }
</style>

<script is:inline>
(function () {
  const text = 'Profesionální web nemusí stát desítky tisíc. Vytvořím vám stránky, které udělají dojem – za férovou cenu.';
  const el = document.querySelector('.ms-typed');
  if (!el) return;
  let i = 0, deleting = false;

  function tick() {
    if (!deleting) {
      el.textContent = text.slice(0, i + 1);
      i++;
      if (i === text.length) { deleting = true; setTimeout(tick, 2200); return; }
      setTimeout(tick, 42);
    } else {
      el.textContent = text.slice(0, i - 1);
      i--;
      if (i === 0) { deleting = false; setTimeout(tick, 600); return; }
      setTimeout(tick, 18);
    }
  }
  tick();
})();
</script>
