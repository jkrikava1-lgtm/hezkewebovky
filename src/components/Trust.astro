---
---

<section class="py-12 md:py-20">
  <div class="max-w-[1400px] mx-auto px-4 md:px-8">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">

      <!-- Left: headline + copy + CTA -->
      <div class="reveal">
        <div class="text-text-muted text-xs tracking-[0.3em] uppercase mb-5">Osobní přístup</div>
        <h2 class="text-4xl md:text-5xl lg:text-[3.25rem] font-bold tracking-tight leading-[1.08] mb-6">
          Rád si <span class="text-accent">promluvím</span><br/>
          o vašem webu.
        </h2>
        <p class="text-text-secondary text-lg leading-relaxed max-w-md mb-10">
          Nejsem agentura. Vždy víte, s kým mluvíte – a kdo za vaším webem stojí. Napište mi a do 24 hodin se ozvu.
        </p>
        <a href="#kontakt" class="magnetic-btn group inline-flex items-center gap-3 px-7 py-4 bg-accent text-black rounded-full font-bold text-sm tracking-wider uppercase hover:bg-white transition-all duration-500" data-hover>
          Napsat zprávu
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      </div>

      <!-- Right: personal card -->
      <div class="reveal reveal-delay-1 flex justify-start md:justify-end">
        <div class="w-full max-w-[380px] border border-dark-border rounded-3xl p-8 bg-dark-card">
          <!-- Avatar + name -->
          <div class="flex items-center gap-4 mb-7">
            <div class="w-16 h-16 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center shrink-0">
              <span class="text-accent font-bold text-xl" style="font-family: 'Inter', sans-serif;">JK</span>
            </div>
            <div>
              <h3 class="text-white font-bold text-lg leading-tight">Jakub Křikava</h3>
              <p class="text-text-muted text-sm mt-0.5">Tvůrce webů · Hezké webovky</p>
            </div>
          </div>
          <!-- Quote -->
          <blockquote class="border-l-2 border-accent/50 pl-4 mb-7">
            <p class="text-text-secondary text-base leading-relaxed" style="font-style: italic;">
              "Každý web tvořím tak, jako by byl pro moji vlastní firmu – pečlivě, rychle a bez zbytečných komplikací."
            </p>
          </blockquote>
          <!-- Stats -->
          <div class="grid grid-cols-3 gap-4 border-t border-dark-border pt-6 mb-6">
            <div class="text-center">
              <div class="text-accent font-bold text-2xl leading-none mb-1">15+</div>
              <div class="text-text-muted text-xs leading-tight">projektů</div>
            </div>
            <div class="text-center">
              <div class="text-white font-bold text-2xl leading-none mb-1">3 r.</div>
              <div class="text-text-muted text-xs leading-tight">praxe</div>
            </div>
            <div class="text-center">
              <div class="text-white font-bold text-2xl leading-none mb-1">24h</div>
              <div class="text-text-muted text-xs leading-tight">odezva</div>
            </div>
          </div>
          <!-- Availability badge -->
          <div class="flex items-center gap-2.5 py-3 px-4 rounded-xl bg-dark-soft border border-dark-border">
            <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></div>
            <span class="text-text-secondary text-sm">Právě přijímám nové projekty</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
