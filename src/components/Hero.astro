---
import hero from '../content/hero.json';
---

<section class="relative pt-24 md:pt-36 xl:pt-48 pb-16 md:pb-24 overflow-hidden" id="hero">
  <div class="relative z-10 max-w-[1400px] mx-auto px-4 md:px-8 w-full">
    <!-- Label -->
    <div class="mb-8 overflow-hidden">
      <div class="text-text-secondary text-xs tracking-[0.3em] uppercase">
        {hero.label}
      </div>
    </div>

    <!-- H1 headline – full width, impactful -->
    <div class="relative inline-block">
      <h1 class="split-text text-[clamp(2.5rem,8vw,8rem)] font-bold leading-[0.95] tracking-tight" id="hero-text">
        <span class="glitch" data-text={hero.headline_line1}>{hero.headline_line1}</span><br/>
        <span class="glitch text-accent" data-text={hero.headline_line2}>{hero.headline_line2}</span>
      </h1>
      <div class="h-[3px] bg-accent mt-4 md:hidden" id="hero-line"></div>
    </div>

    <!-- Bottom row: subtext + CTA (left) | JK card (right, desktop only) -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 border-t border-dark-border pt-8 items-start">

      <!-- Left: subtext + CTA -->
      <div>
        <p class="text-text-secondary text-lg md:text-xl max-w-md leading-relaxed mb-8" id="hero-subtext" data-text={hero.subtext}>
          {hero.subtext}
        </p>
        <a href="#kontakt" class="magnetic-btn group flex items-center gap-3 text-white w-fit" data-hover>
          <span class="text-base tracking-wider uppercase">{hero.cta_text}</span>
          <span class="w-12 h-12 rounded-full border border-accent/40 flex items-center justify-center group-hover:bg-accent group-hover:border-accent transition-all duration-500">
            <svg class="w-4 h-4 text-accent group-hover:text-black transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10" />
            </svg>
          </span>
        </a>
      </div>

      <!-- Right: JK card – desktop only -->
      <div class="hidden lg:block w-[260px]">
        <div class="border border-dark-border rounded-2xl p-5 bg-dark-card/80 backdrop-blur-sm">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center shrink-0">
              <span class="text-accent font-bold text-sm" style="font-family: 'Inter', sans-serif;">JK</span>
            </div>
            <div>
              <p class="text-white text-sm font-semibold leading-tight">Jakub Křikava</p>
              <p class="text-text-muted text-xs mt-0.5">Tvůrce webů</p>
            </div>
          </div>
          <div class="space-y-2 border-t border-dark-border pt-4 mb-4">
            <div class="flex items-center justify-between">
              <span class="text-text-muted text-xs">Hotových projektů</span>
              <span class="text-accent font-bold text-xs">15+</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-text-muted text-xs">Průměrná doba</span>
              <span class="text-white text-xs font-medium">3 týdny</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-text-muted text-xs">Cena od</span>
              <span class="text-white text-xs font-medium">9 900 Kč</span>
            </div>
          </div>
          <div class="flex items-center gap-2 border-t border-dark-border pt-3">
            <div class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></div>
            <span class="text-text-muted text-xs">Přijímám projekty</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Social proof badges -->
    <div class="mt-8 flex flex-wrap items-center gap-2">
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-dark-border bg-dark-card/60 text-xs">
        <svg class="w-3 h-3 text-yellow-400 fill-yellow-400 shrink-0" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span class="text-text-secondary">Spokojení zákazníci</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-dark-border bg-dark-card/60 text-xs">
        <span class="text-accent font-bold">15+</span>
        <span class="text-text-secondary">dokončených projektů</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-dark-border bg-dark-card/60 text-xs">
        <svg class="w-3 h-3 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-white font-medium">do 3 týdnů</span>
        <span class="text-text-muted">hotovo</span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-dark-border bg-dark-card/60 text-xs">
        <svg class="w-3 h-3 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-white font-medium">žádné skryté poplatky</span>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-8 w-px h-16 bg-gradient-to-b from-transparent to-accent/30"></div>
</section>

<script>
  const heroText = document.getElementById('hero-text');
  if (heroText) {
    const lines = heroText.innerHTML.split(/<br\s*\/?>/i);
    let wordIndex = 0;
    const processedLines = lines.map((line) => {
      const parts = line.split(/(\s+|<[^>]+>)/);
      return parts.map((part) => {
        if (part.match(/^</) || part.match(/^\s*$/)) return part;
        wordIndex++;
        const delay = wordIndex * 0.18;
        return `<span class="word"><span class="word-inner" style="transition-delay: ${delay}s">${part}</span></span>`;
      }).join('');
    });
    heroText.innerHTML = processedLines.join('<br/>');
    setTimeout(() => heroText.classList.add('revealed'), 1500);
  }

  // Typing effect – desktop only
  if (window.matchMedia('(pointer: fine)').matches) {
    const subtext = document.getElementById('hero-subtext');
    if (subtext) {
      const fullText = subtext.getAttribute('data-text') || '';
      const height = subtext.offsetHeight;
      subtext.style.minHeight = height + 'px';

      const cursor = document.createElement('span');
      cursor.style.cssText = 'display:inline-block;width:2px;background:#c8ff00;margin-left:1px;vertical-align:text-bottom;animation:blink 0.8s step-end infinite;';
      cursor.style.height = window.getComputedStyle(subtext).lineHeight;

      subtext.textContent = '';
      subtext.appendChild(cursor);

      let i = 0;
      setTimeout(() => {
        const typeInterval = setInterval(() => {
          cursor.before(fullText[i]);
          i++;
          if (i >= fullText.length) {
            clearInterval(typeInterval);
            setTimeout(() => cursor.remove(), 1000);

            const h1 = document.querySelector('h1');
            if (h1) {
              h1.classList.add('glitch-active');
              setTimeout(() => h1.classList.remove('glitch-active'), 3000);
            }
          }
        }, 25);
      }, 2800);
    }
  }
</script>
