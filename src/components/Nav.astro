---
const links = [
  { label: 'Služby', href: '/sluzby' },
  { label: 'Ukázky', href: '/ukazky' },
  { label: 'Cena', href: '/cena' },
  { label: 'Blog', href: '/blog' },
  { label: 'O mně', href: '/o-mne' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 pt-4 md:pt-5 transition-all duration-500 ease-out" id="navbar">
  <!-- Wrapper that transitions from full-width bar to floating pill -->
  <div class="transition-all duration-500 ease-out mx-auto flex items-center justify-between" id="navbar-inner"
       style="max-width: 1400px; padding: 10px 16px; border-radius: 0px; background: transparent; border: 1px solid transparent;">

    <!-- Logo -->
    <a href="/" onclick="event.preventDefault(); if(location.pathname==='/'){window.history.replaceState({},'','/');window.scrollTo({top:0,behavior:'smooth'});}else{location.href='/'}" class="flex items-center gap-0 tracking-tight cursor-pointer" id="nav-logo" data-hover>
      <span class="relative font-bold text-white transition-all duration-500" id="nav-logo-text" style="font-family: 'Inter', sans-serif; font-size: 1.5rem;">hezké<img src="/icon-cursor.png" alt="" class="absolute object-contain logo-cursor" id="nav-logo-icon" style="top: -0.5rem; right: -0.4rem; height: 1.6rem;" /></span>
      <span class="font-light text-white transition-all duration-500" id="nav-logo-sub" style="font-family: 'Nunito', sans-serif; font-size: 1.5rem; margin-left: 0.4rem;">webovky</span>
    </a>

    <!-- Desktop menu -->
    <div class="hidden lg:flex items-center gap-6">
      {links.map(({ label, href }) => (
        <a
          href={href}
          class="text-white/70 text-[13px] tracking-widest uppercase hover:text-white transition-colors duration-500"
          data-hover
        >
          {label}
        </a>
      ))}
    </div>

    <!-- CTA -->
    <a
      href="/chci-hezky-web"
      class="nav-cta magnetic-btn px-5 py-2.5 bg-accent text-black rounded-full text-xs tracking-widest uppercase font-semibold hover:bg-white transition-all duration-500"
      data-hover
    >
      Chci hezký web
    </a>

    <!-- Mobile CTA -->
    <a href="/chci-hezky-web" class="lg:hidden px-4 py-2 bg-accent text-black rounded-full text-xs tracking-widest uppercase font-semibold">
      Chci web
    </a>

    <!-- Mobile hamburger -->
    <button class="lg:hidden text-white p-2" id="mobile-menu-btn" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="lg:hidden hidden border-t border-white/10" id="mobile-menu" style="background: rgba(10,10,10,0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);">
    <div class="px-6 py-6 flex flex-col gap-1">
      {links.map(({ label, href }) => (
        <a href={href} class="text-white/70 text-base py-2 hover:text-white transition-colors">{label}</a>
      ))}
      <a href="/chci-hezky-web" class="mt-4 px-5 py-3 bg-accent text-black text-center text-sm font-medium rounded-lg">
        Chci hezký web
      </a>
    </div>
  </div>
</nav>

<style>
  #navbar-inner {
    will-change: max-width, border-radius, background, padding;
  }
  .nav-cta { display: none; }
  @media (min-width: 1024px) {
    .nav-cta { display: inline-flex; }
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const inner = document.getElementById('navbar-inner') as HTMLElement | null;
  const logoText = document.getElementById('nav-logo-text') as HTMLElement | null;
  const logoSub = document.getElementById('nav-logo-sub') as HTMLElement | null;
  const logoIcon = document.getElementById('nav-logo-icon') as HTMLElement | null;

  const isMobile = () => window.innerWidth < 1024;

  let scrolled = false;

  function updateNav() {
    const isScrolled = window.scrollY > 60;
    if (isScrolled === scrolled) return;
    scrolled = isScrolled;

    if (!inner) return;

    const mobile = isMobile();

    if (isScrolled) {
      inner.style.maxWidth = mobile ? '360px' : '860px';
      inner.style.padding = mobile ? '12px 16px' : '14px 24px';
      inner.style.borderRadius = '100px';
      inner.style.background = 'rgba(12,12,12,0.15)';
      inner.style.backdropFilter = 'blur(20px)';
      (inner.style as any).webkitBackdropFilter = 'blur(20px)';
      inner.style.border = '1px solid rgba(255,255,255,0.08)';
      inner.style.boxShadow = '0 8px 32px rgba(0,0,0,0.4)';
      if (logoText) { logoText.style.fontSize = mobile ? '1rem' : '1.25rem'; logoText.style.lineHeight = '1'; }
      if (logoSub) { logoSub.style.fontSize = mobile ? '1rem' : '1.25rem'; logoSub.style.marginLeft = mobile ? '0.35rem' : '0.5rem'; }
      if (logoIcon) { logoIcon.style.top = '-0.3rem'; logoIcon.style.right = mobile ? '-0.3rem' : '-0.4rem'; logoIcon.style.height = mobile ? '1.1rem' : '1.4rem'; }
      navbar!.style.paddingTop = mobile ? '8px' : '10px';
    } else {
      inner.style.maxWidth = '1400px';
      inner.style.padding = mobile ? '10px 16px' : '12px 32px';
      inner.style.borderRadius = '0px';
      inner.style.background = 'transparent';
      inner.style.backdropFilter = 'none';
      (inner.style as any).webkitBackdropFilter = 'none';
      inner.style.border = '1px solid transparent';
      inner.style.boxShadow = 'none';
      if (logoText) { logoText.style.fontSize = mobile ? '1.5rem' : '2.25rem'; logoText.style.lineHeight = ''; }
      if (logoSub) { logoSub.style.fontSize = mobile ? '1.5rem' : '2.25rem'; logoSub.style.marginLeft = mobile ? '0.4rem' : '0.625rem'; }
      if (logoIcon) { logoIcon.style.top = mobile ? '-0.5rem' : '-0.875rem'; logoIcon.style.right = mobile ? '-0.4rem' : '-0.75rem'; logoIcon.style.height = mobile ? '1.6rem' : '2.5rem'; }
      navbar!.style.paddingTop = mobile ? '0.5rem' : '1.25rem';
    }
  }

  function initNav() {
    if (!inner) return;
    const mobile = isMobile();
    inner.style.padding = mobile ? '10px 16px' : '12px 32px';
    if (logoText) logoText.style.fontSize = mobile ? '1.5rem' : '2.25rem';
    if (logoSub) { logoSub.style.fontSize = mobile ? '1.5rem' : '2.25rem'; logoSub.style.marginLeft = mobile ? '0.4rem' : '0.625rem'; }
    if (logoIcon) { logoIcon.style.top = mobile ? '-0.5rem' : '-0.875rem'; logoIcon.style.right = mobile ? '-0.4rem' : '-0.75rem'; logoIcon.style.height = mobile ? '1.6rem' : '2.5rem'; }
    navbar!.style.paddingTop = mobile ? '0.5rem' : '1.25rem';
    scrolled = false;
  }

  window.addEventListener('scroll', updateNav, { passive: true });
  window.addEventListener('resize', initNav, { passive: true });
  initNav();

  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => menu?.classList.add('hidden'));
  });
</script>
