---
const links = [
  { label: 'Ukázky', href: '/#ukazky' },
  { label: 'Cena', href: '/#cena' },
  { label: 'Blog', href: '/blog' },
  { label: 'O mně', href: '/o-mne' },
  { label: 'Kontakt', href: '/#kontakt' },
];

const sluzbyLinks = [
  { label: 'Tvorba webu na míru', href: '/sluzby#tvorba-webu', desc: 'od 9 900 Kč' },
  { label: 'E-shop', href: '/sluzby#eshop', desc: 'od 19 900 Kč' },
  { label: 'Redesign webu', href: '/sluzby#redesign', desc: 'od 7 900 Kč' },
  { label: 'SEO & Viditelnost', href: '/sluzby#seo', desc: 'od 3 900 Kč' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="navbar">
  <div class="max-w-[1400px] mx-auto px-4 md:px-8 py-4 md:py-6 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" onclick="event.preventDefault(); if(location.pathname==='/'){window.history.replaceState({},'','/');window.scrollTo({top:0,behavior:'smooth'});}else{location.href='/'}" class="flex items-center gap-0 text-xl md:text-4xl tracking-tight cursor-pointer" data-hover>
      <span class="relative font-bold text-white" style="font-family: 'Inter', sans-serif;">hezké<img src="/icon-cursor.png" alt="" class="absolute -top-1.5 md:-top-3.5 -right-1.5 md:-right-3 h-5 md:h-10 object-contain logo-cursor" /></span>
      <span class="font-light text-white ml-1 md:ml-2.5" style="font-family: 'Nunito', sans-serif;">webovky</span>
    </a>

    <!-- Desktop menu -->
    <div class="hidden lg:flex items-center gap-6">

      <!-- Služby dropdown -->
      <div class="relative" data-nav-group>
        <a
          href="/sluzby"
          class="flex items-center gap-1 text-white/60 text-xs tracking-widest uppercase hover:text-white transition-colors duration-500"
          data-hover
        >
          Služby
          <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
        <div class="absolute top-full left-0 hidden pt-3 z-50" data-nav-dropdown>
          <div class="bg-dark-card border border-dark-border rounded-2xl p-2 min-w-[260px] shadow-2xl shadow-black/60">
            {sluzbyLinks.map(({ label, href, desc }) => (
              <a
                href={href}
                class="flex items-center justify-between gap-4 px-4 py-3 rounded-xl hover:bg-dark-soft transition-colors duration-200 group"
                data-hover
              >
                <span class="text-white/80 text-sm group-hover:text-white transition-colors">{label}</span>
                <span class="text-text-muted text-xs shrink-0">{desc}</span>
              </a>
            ))}
            <div class="mx-4 my-1 h-px bg-dark-border"></div>
            <a href="/sluzby" class="flex items-center gap-2 px-4 py-2.5 rounded-xl hover:bg-dark-soft transition-colors duration-200" data-hover>
              <span class="text-accent text-xs font-medium tracking-wide">Všechny služby →</span>
            </a>
          </div>
        </div>
      </div>

      {links.map(({ label, href }) => (
        <a
          href={href}
          class="text-white/60 text-xs tracking-widest uppercase hover:text-white transition-colors duration-500"
          data-hover
        >
          {label}
        </a>
      ))}
    </div>

    <!-- CTA -->
    <a
      href="/#kontakt"
      class="hidden lg:inline-flex magnetic-btn px-5 py-2.5 bg-accent text-black rounded-full text-xs tracking-widest uppercase font-semibold hover:bg-white transition-all duration-500"
      data-hover
    >
      Chci hezký web
    </a>

    <!-- Mobile hamburger -->
    <button class="lg:hidden text-white p-2" id="mobile-menu-btn" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="lg:hidden hidden bg-dark border-t border-dark-border" id="mobile-menu">
    <div class="px-6 py-6 flex flex-col gap-1">
      <!-- Služby group -->
      <div class="py-2 border-b border-dark-border/50 mb-2">
        <div class="text-text-muted text-xs tracking-widest uppercase mb-3">Služby</div>
        {sluzbyLinks.map(({ label, href, desc }) => (
          <a href={href} class="flex items-center justify-between py-2 text-white/70 hover:text-white transition-colors">
            <span class="text-sm">{label}</span>
            <span class="text-text-muted text-xs">{desc}</span>
          </a>
        ))}
      </div>
      {links.map(({ label, href }) => (
        <a href={href} class="text-white/70 text-base py-2 hover:text-white transition-colors">{label}</a>
      ))}
      <a href="/#kontakt" class="mt-4 px-5 py-3 bg-accent text-black text-center text-sm font-medium rounded-lg">
        Chci hezký web
      </a>
    </div>
  </div>
</nav>

<script>
  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => menu?.classList.add('hidden'));
  });

  // Desktop dropdown – JS hover s 150ms delay (CSS group-hover nefunguje kvůli gap)
  document.querySelectorAll('[data-nav-group]').forEach((group) => {
    const dropdown = group.querySelector('[data-nav-dropdown]') as HTMLElement | null;
    let timer: ReturnType<typeof setTimeout>;
    group.addEventListener('mouseenter', () => {
      clearTimeout(timer);
      dropdown?.classList.remove('hidden');
    });
    group.addEventListener('mouseleave', () => {
      timer = setTimeout(() => dropdown?.classList.add('hidden'), 150);
    });
  });
</script>
